# ── Supabase (required) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── LLM narration (OPTIONAL — off by default) ───────────────────────
LLM_NARRATION_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Exchanges (public order books — no keys required) ───────────────
EXCHANGE_A=okx
EXCHANGE_B=bybit
EXCHANGE_C=bybit
SYMBOL=BTC/USDT
USE_SANDBOX=false

# ── Demo CEX trading (OKX Demo + Bybit Demo) ────────────────────────
DEMO_TRADE_ENABLED=false
DEMO_MIN_QTY_BTC=0.001

OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSWORD=

BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# false = Demo Trading integrado (bybit.com); true = testnet.bybit.com
BYBIT_DEMO_USE_TESTNET=false

# ── Strategy / risk ─────────────────────────────────────────────────
MIN_NET_PROFIT_USD=25
TAKER_FEE_OKX=0.0008
TAKER_FEE_BYBIT=0.001
TAKER_FEE_KRAKEN=0.0026
TAKER_FEE_BINANCE=0.001
SLIPPAGE_RATE=0.0005
WITHDRAWAL_FEE_USD=10
MAX_DRAWDOWN_PCT=0.5
POLL_INTERVAL_MS=500
START_BALANCE_USDT=100000
START_BALANCE_BTC=2

# ── Wiring ──────────────────────────────────────────────────────────
ENGINE_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://ppolom-web.fly.dev
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_ENGINE_WS=ws://localhost:8000/ws
