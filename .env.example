# ── Supabase (required) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── LLM narration (OPTIONAL — off by default) ───────────────────────
LLM_NARRATION_ENABLED=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Exchanges (public order books need NO keys) ─────────────────────
EXCHANGE_A=binance
EXCHANGE_B=okx
EXCHANGE_C=kraken
SYMBOL=BTC/USDT
USE_SANDBOX=false

# Optional testnet keys (paper execution only)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSWORD=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Strategy / risk ─────────────────────────────────────────────────
MIN_NET_PROFIT_USD=25
TAKER_FEE_BINANCE=0.001
TAKER_FEE_OKX=0.0008
TAKER_FEE_KRAKEN=0.0026
SLIPPAGE_RATE=0.0005
WITHDRAWAL_FEE_USD=10
MAX_DRAWDOWN_PCT=0.5
POLL_INTERVAL_MS=500
START_BALANCE_USDT=100000
START_BALANCE_BTC=2

# ── Wiring ──────────────────────────────────────────────────────────
ENGINE_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://ppolom-web.fly.dev
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_ENGINE_WS=ws://localhost:8000/ws
